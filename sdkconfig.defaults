CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="main/partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_NETWORK_PROV_NETWORK_TYPE_WIFI=y
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_USE_CANVAS=y
CONFIG_LV_USE_GESTURE_RECOGNITION=n
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
# Concurrent service TLS contexts use PSRAM, preserving internal RAM for Wi-Fi and task stacks.
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Keep ordinary UI/font allocations in PSRAM; reserve internal RAM for stacks and AES DMA.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
